diff --git a/scripts/build-android.sh b/scripts/build-android.sh
--- a/scripts/build-android.sh
+++ b/scripts/build-android.sh
@@ -83,6 +83,30 @@
     ;;
 esac
 
+if [ "${PX4_ANDROID_BUILD_JOBS+x}" = x ]; then
+    case "$PX4_ANDROID_BUILD_JOBS" in
+        ''|*[!0-9]*)
+            printf '%s\n' 'PX4_ANDROID_BUILD_JOBS must be a positive integer' >&2
+            exit 2
+            ;;
+    esac
+    case "$PX4_ANDROID_BUILD_JOBS" in
+        *[1-9]*) ;;
+        *)
+            printf '%s\n' 'PX4_ANDROID_BUILD_JOBS must be a positive integer' >&2
+            exit 2
+            ;;
+    esac
+    jobs=$PX4_ANDROID_BUILD_JOBS
+else
+    jobs=$(getconf _NPROCESSORS_ONLN 2>/dev/null || printf '%s' 2)
+    case "$jobs" in
+        ''|*[!0-9]*) jobs=2 ;;
+        *[1-9]*) ;;
+        *) jobs=2 ;;
+    esac
+fi
+
 ndk=${ANDROID_NDK_HOME:-${ANDROID_NDK_ROOT:-}}
 [ -n "$ndk" ] && [ -d "$ndk" ] || {
     printf '%s\n' 'ANDROID_NDK_HOME must point to NDK r26 or newer' >&2

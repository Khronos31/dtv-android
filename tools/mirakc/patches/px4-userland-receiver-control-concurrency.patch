+bool test_same_device_receivers_have_independent_workers(Fixture& fixture)
+{
+    fixture.tuner_backend.receiver4_started.store(false);
+    fixture.tuner_backend.block_receiver4.store(true);
+    auto created = ControlWorkerLanes::create(fixture.card, fixture.tuner);
+    CHECK(created);
+    std::unique_ptr<ControlWorkerLanes> workers = std::move(created.value());
+    BlockedReceiver4Guard blocked_guard(fixture.tuner_backend);
+
+    ControlWorkerTask slow{};
+    slow.operation = ControlWorkerOperation::tuner_acquire;
+    slow.client_id = 31U;
+    slow.request_id = 310U;
+    slow.receiver = 4U;
+    CHECK(workers->submit(tuner_lane_for_receiver(4U), slow));
+    {
+        std::unique_lock<std::mutex> lock(fixture.tuner_backend.receiver4_mutex);
+        CHECK(fixture.tuner_backend.receiver4_condition.wait_for(
+            lock, std::chrono::seconds(10), [&]() {
+                return fixture.tuner_backend.receiver4_started.load();
+            }));
+    }
+
+    ControlWorkerTask sibling{};
+    sibling.operation = ControlWorkerOperation::tuner_acquire;
+    sibling.client_id = 32U;
+    sibling.request_id = 320U;
+    sibling.receiver = 5U;
+    CHECK(workers->submit(tuner_lane_for_receiver(5U), sibling));
+
+    bool sibling_completed_while_receiver4_blocked = false;
+    const auto deadline = std::chrono::steady_clock::now() +
+                          std::chrono::seconds(2);
+    while (std::chrono::steady_clock::now() < deadline) {
+        ControlWorkerCompletion completion{};
+        while (workers->try_pop(tuner_lane_for_receiver(5U), completion)) {
+            if (completion.request_id == 320U)
+                sibling_completed_while_receiver4_blocked = true;
+        }
+        if (sibling_completed_while_receiver4_blocked) break;
+        pollfd ready{workers->wake_fd(), POLLIN, 0};
+        (void)::poll(&ready, 1U, 10);
+        workers->drain_wake();
+    }
+
+    fixture.tuner_backend.block_receiver4.store(false);
+    fixture.tuner_backend.receiver4_condition.notify_all();
+    std::size_t observed = 0U;
+    CHECK(drain_until_stopped(*workers, 1U, observed));
+    CHECK(sibling_completed_while_receiver4_blocked);
+    CHECK(fixture.tuner.disconnect_client(31U));
+    CHECK(fixture.tuner.disconnect_client(32U));
+    return true;
+}

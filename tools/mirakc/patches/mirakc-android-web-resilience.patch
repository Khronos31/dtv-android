+    /// Accept one app-private trigger without adding a public control endpoint.
+    /// The marker is created only by the Android app's DUMP-protected provider;
+    /// removing it before dispatch makes duplicate triggers idempotent.
+    fn schedule_acceptance_trigger(&self, ctx: &mut Context<Self>) {
+        let Some(cache_dir) = self.config.epg.cache_dir.clone() else {
+            return;
+        };
+        let marker = cache_dir.join(".acceptance-update-schedules");
+        let gr_scan_marker = cache_dir.join(".acceptance-gr-scan");
+        let addr = ctx.address().clone();
+        ctx.spawn_task(async move {
+            loop {
+                tokio::time::sleep(std::time::Duration::from_millis(1000)).await;
+                match tokio::fs::remove_file(&marker).await {
+                    Ok(()) => addr.emit(InvokeUpdateSchedules).await,
+                    Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+                    Err(error) => tracing::warn!(?error, "Failed to read acceptance trigger"),
+                }
+                match tokio::fs::remove_file(&gr_scan_marker).await {
+                    Ok(()) => addr.emit(InvokeGrScan).await,
+                    Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+                    Err(error) => tracing::warn!(?error, "Failed to read GR scan trigger"),
+                }
+            }
+        });
+    }

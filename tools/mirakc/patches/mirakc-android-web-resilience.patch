+        assert_eq!(result.found_channels, expected_channels);
+        assert_eq!(result.completed, 40);
+        assert!(!result.interrupted);
+        assert_eq!(progress.len(), 81);
+        assert_eq!(progress[0].0, 0);
+        assert_eq!(progress[0].1, None);
+        assert_eq!(progress[1].0, 0);
+        assert_eq!(progress[1].1, Some(13));
+        assert_eq!(progress[2].0, 1);
+        assert_eq!(progress[2].1, None);
+        assert_eq!(progress[3].0, 1);
+        assert_eq!(progress[3].1, Some(14));
+        assert_eq!(progress[progress.len() - 2].0, 39);
+        assert_eq!(progress[progress.len() - 2].1, Some(52));
+        assert_eq!(progress.last().unwrap().0, 40);
+        assert_eq!(progress.last().unwrap().1, None);
+        assert_eq!(progress.last().unwrap().2, expected_channels);
+    }
+
+    #[test(tokio::test)]
+    async fn gr_scan_stops_between_channels_when_cancelled() {
+        use std::sync::atomic::{AtomicBool, Ordering};
+
+        let expected = vec![TsService {
+            nid: 1.into(),
+            tsid: 2.into(),
+            sid: 3.into(),
+            service_type: 4,
+            logo_id: 0,
+            remote_control_key_id: 1,
+            name: "service".to_string(),
+        }];
+        let config_yml = format!(
+            r#"
+            jobs:
+              scan-services:
+                command: echo '{}'
+        "#,
+            serde_json::to_string(&expected).unwrap()
+        );
+        let config = Arc::new(serde_norway::from_str::<Config>(&config_yml).unwrap());
+        let scan = ServiceScanner::new(config, TunerManagerStub::default());
+        let cancelled = AtomicBool::new(false);
+
+        let result = scan
+            .scan_gr_channels(
+                |completed, channel, _| {
+                    if completed == 1 && channel.is_none() {
+                        cancelled.store(true, Ordering::SeqCst);
+                    }
+                    Ok(())
+                },
+                || cancelled.load(Ordering::SeqCst),
+            )
+            .await
+            .unwrap();
+
+        assert!(result.interrupted);
+        assert_eq!(result.completed, 1);
+        assert_eq!(result.current_channel, None);
+        assert_eq!(result.found_channels, vec![13]);
+    }
+
+    #[test(tokio::test)]
+    async fn gr_scan_treats_empty_channels_as_unavailable_not_scan_failures() {
+        let config_yml = r#"
+            jobs:
+              scan-services:
+                command: "printf ''"
+        "#;
+        let config = Arc::new(serde_norway::from_str::<Config>(config_yml).unwrap());
+        let scan = ServiceScanner::new(config, TunerManagerStub::default());
+
+        let result = scan
+            .scan_gr_channels(|_, _, _| Ok(()), || false)
+            .await
+            .unwrap();
+
+        assert!(result.found_channels.is_empty());
+        assert_eq!(result.failed_channels, 0);
+        assert_eq!(result.completed, 40);
+        assert!(!result.interrupted);
+    }
 }

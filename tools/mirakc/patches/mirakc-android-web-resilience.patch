+fn write_gr_scan_status(
+    cache_dir: &Path,
+    scan_id: u64,
+    state: &str,
+    completed: usize,
+    current_channel: Option<u16>,
+    found_channels: &[u16],
+    failed_channels: usize,
+    error_code: Option<&str>,
+) -> io::Result<()> {
+    let destination = cache_dir.join(".gr-scan-state");
+    let temporary = cache_dir.join(".gr-scan-state.tmp");
+    let found = found_channels
+        .iter()
+        .map(u16::to_string)
+        .collect::<Vec<_>>()
+        .join(",");
+    let contents = format!(
+        "{state}\n{completed}\n50\n{}\n{found}\n{failed_channels}\n{scan_id}\n{}\n",
+        current_channel
+            .map(|value| value.to_string())
+            .unwrap_or_default(),
+        error_code.unwrap_or("NONE")
+    );
+    std::fs::write(&temporary, contents)?;
+    std::fs::rename(temporary, destination)
+}
+
+fn new_gr_scan_id() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|duration| duration.as_millis() as u64)
+        .unwrap_or_default()
+        .max(1)
+}

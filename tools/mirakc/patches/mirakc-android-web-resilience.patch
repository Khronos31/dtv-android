+/// Parse the Android adapter's fixed-delay form.  It deliberately accepts
+/// whole minutes only, so the UI and upstream scheduler share one strict range.
+pub(crate) fn parse_fixed_delay_schedule(schedule: &str) -> Option<std::time::Duration> {
+    let minutes = schedule
+        .strip_prefix("@every ")?
+        .strip_suffix('m')?
+        .parse::<u64>()
+        .ok()?;
+    (1..=1440)
+        .contains(&minutes)
+        .then(|| std::time::Duration::from_secs(minutes * 60))
+}

+fn write_gr_scan_status(
+    cache_dir: &Path,
+    scan_id: u64,
+    state: &str,
+    completed: usize,
+    current_channel: Option<u16>,
+    found_channels: &[u16],
+    failed_channels: usize,
+    error_code: Option<&str>,
+) -> io::Result<()> {
+    let destination = cache_dir.join(".gr-scan-state");
+    let temporary = cache_dir.join(".gr-scan-state.tmp");
+    let found = found_channels
+        .iter()
+        .map(u16::to_string)
+        .collect::<Vec<_>>()
+        .join(",");
+    let contents = format!(
+        "{state}\n{completed}\n{GR_SCAN_TOTAL_CHANNELS}\n{}\n{found}\n{failed_channels}\n{scan_id}\n{}\n",
+        current_channel
+            .map(|value| value.to_string())
+            .unwrap_or_default(),
+        error_code.unwrap_or("NONE")
+    );
+    std::fs::write(&temporary, contents)?;
+    std::fs::rename(temporary, destination)
+}
+
+fn new_gr_scan_id() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|duration| duration.as_millis() as u64)
+        .unwrap_or_default()
+        .max(1)
+}
+
+const MAX_GR_SCAN_STATE_BYTES: u64 = 4096;
+
+fn queued_gr_scan_request_id(cache_dir: &Path) -> Option<u64> {
+    let state_file = cache_dir.join(".gr-scan-state");
+    let mut contents = Vec::new();
+    std::fs::File::open(state_file)
+        .ok()?
+        .take(MAX_GR_SCAN_STATE_BYTES + 1)
+        .read_to_end(&mut contents)
+        .ok()?;
+    if contents.len() as u64 > MAX_GR_SCAN_STATE_BYTES {
+        return None;
+    }
+    let contents = std::str::from_utf8(&contents).ok()?;
+    let fields = contents.trim_end_matches('\n').split('\n').collect::<Vec<_>>();
+    if fields.len() != 8
+        || fields[0] != "queued"
+        || fields[1] != "0"
+        || fields[2].parse::<usize>().ok() != Some(GR_SCAN_TOTAL_CHANNELS)
+        || !fields[3].is_empty()
+        || !fields[4].is_empty()
+        || fields[5] != "0"
+        || fields[7] != "NONE"
+    {
+        return None;
+    }
+    fields[6]
+        .parse::<u64>()
+        .ok()
+        .filter(|scan_id| *scan_id > 0 && *scan_id <= i64::MAX as u64)
+}
+
+fn scan_id_for_gr_scan<F>(cache_dir: &Path, fresh_scan_id: F) -> u64
+where
+    F: FnOnce() -> u64,
+{
+    queued_gr_scan_request_id(cache_dir).unwrap_or_else(fresh_scan_id)
+}
+

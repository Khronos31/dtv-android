+    /// Scan every Japan terrestrial physical channel through the same tuner
+    /// manager and low-priority job lease used by EPG service discovery.
+    /// Errors are counted separately so the Android caller can fail closed
+    /// instead of applying a partial channel list.
+    pub async fn scan_gr_channels<F, C>(
+        &self,
+        mut on_progress: F,
+        should_cancel: C,
+    ) -> std::io::Result<GrScanResult>
+    where
+        F: FnMut(usize, Option<u16>, &[u16]) -> std::io::Result<()> + Send,
+        C: Fn() -> bool + Send,
+    {
+        const CHANNEL_COUNT: usize = 50;
+        let mut found_channels = Vec::new();
+        let mut failed_channels = 0;
+        let mut completed = 0;
+        let mut current_channel = None;
+        let mut interrupted = false;
+        let command = &self.config.jobs.scan_services.command;
+
+        on_progress(0, None, &found_channels)?;
+        for (index, channel_number) in (13u16..=62).enumerate() {
+            if should_cancel() {
+                interrupted = true;
+                break;
+            }
+            let channel = ChannelConfig {
+                name: format!("GR-{channel_number}"),
+                channel_type: ChannelType::GR,
+                channel: channel_number.to_string(),
+                extra_args: String::new(),
+                services: Vec::new(),
+                excluded_services: Vec::new(),
+                disabled: false,
+            };
+            match Self::scan_services_in_channel(&channel, command, &self.tuner_manager).await {
+                Ok(services) if !services.is_empty() => found_channels.push(channel_number),
+                Ok(_) => {}
+                Err(error) if error.downcast_ref::<NoServiceFound>().is_some() => {}
+                Err(_) => {
+                    // Error text can include commands or paths; progress state
+                    // records only the count and never serializes raw errors.
+                    tracing::warn!(channel = channel_number, "GR channel scan failed");
+                    failed_channels += 1;
+                }
+            }
+            completed = index + 1;
+            current_channel = Some(channel_number);
+            on_progress(index + 1, Some(channel_number), &found_channels)?;
+        }
+        debug_assert_eq!(CHANNEL_COUNT, 62 - 13 + 1);
+        Ok(GrScanResult {
+            found_channels,
+            failed_channels,
+            completed,
+            current_channel,
+            interrupted,
+        })
+    }

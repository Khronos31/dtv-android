+const GR_SCAN_FIRST_CHANNEL: u16 = 13;
+const GR_SCAN_LAST_CHANNEL: u16 = 52;
+pub(super) const GR_SCAN_TOTAL_CHANNELS: usize = (GR_SCAN_LAST_CHANNEL - GR_SCAN_FIRST_CHANNEL + 1) as usize;
+const GR_SCAN_MAX_WORKERS: usize = 8;
+const GR_SCAN_CANCEL_POLL_INTERVAL: Duration = Duration::from_millis(25);
+
+type GrScanTask = Pin<Box<dyn Future<Output = (u16, anyhow::Result<bool>)> + Send>>;
+
+fn gr_scan_worker_count(config: &Config) -> usize {
+    config
+        .tuners
+        .iter()
+        .filter(|tuner| !tuner.disabled && tuner.channel_types.contains(&ChannelType::GR))
+        .count()
+        .clamp(1, GR_SCAN_MAX_WORKERS)
+        .min(GR_SCAN_TOTAL_CHANNELS)
+}
+
+fn publish_gr_scan_progress<F>(
+    on_progress: &mut F,
+    completed: usize,
+    in_flight: &BTreeSet<u16>,
+    found_channels: &BTreeSet<u16>,
+) -> std::io::Result<()>
+where
+    F: FnMut(usize, Option<u16>, &[u16]) -> std::io::Result<()>,
+{
+    let found = found_channels.iter().copied().collect::<Vec<_>>();
+    on_progress(completed, in_flight.first().copied(), &found)
+}
+
+fn admit_next_gr_scan_task<F, Fut, P>(
+    tasks: &mut FuturesUnordered<GrScanTask>,
+    next_channel: &mut u16,
+    in_flight: &mut BTreeSet<u16>,
+    completed: usize,
+    found_channels: &BTreeSet<u16>,
+    scan_channel: &F,
+    on_progress: &mut P,
+) -> std::io::Result<bool>
+where
+    F: Fn(u16) -> Fut,
+    Fut: Future<Output = anyhow::Result<bool>> + Send + 'static,
+    P: FnMut(usize, Option<u16>, &[u16]) -> std::io::Result<()>,
+{
+    if *next_channel > GR_SCAN_LAST_CHANNEL {
+        return Ok(false);
+    }
+    let channel = *next_channel;
+    *next_channel += 1;
+    in_flight.insert(channel);
+    if let Err(error) = publish_gr_scan_progress(on_progress, completed, in_flight, found_channels)
+    {
+        in_flight.remove(&channel);
+        return Err(error);
+    }
+    let scan_channel = scan_channel(channel);
+    tasks.push(Box::pin(async move { (channel, scan_channel.await) }));
+    Ok(true)
+}
+
+async fn run_bounded_gr_scan<F, Fut, P, C>(
+    worker_limit: usize,
+    scan_channel: F,
+    mut on_progress: P,
+    should_cancel: C,
+) -> std::io::Result<GrScanResult>
+where
+    F: Fn(u16) -> Fut + Clone + Send + Sync + 'static,
+    Fut: Future<Output = anyhow::Result<bool>> + Send + 'static,
+    P: FnMut(usize, Option<u16>, &[u16]) -> std::io::Result<()> + Send,
+    C: Fn() -> bool + Send,
+{
+    let worker_limit = worker_limit.clamp(1, GR_SCAN_MAX_WORKERS);
+    let mut tasks = FuturesUnordered::<GrScanTask>::new();
+    let mut next_channel = GR_SCAN_FIRST_CHANNEL;
+    let mut in_flight = BTreeSet::new();
+    let mut found_channels = BTreeSet::new();
+    let mut failed_channels = 0;
+    let mut completed = 0;
+    let mut cancellation_observed = false;
+    let mut stop_admitting = false;
+    let mut progress_error = None;
+
+    on_progress(0, None, &[])?;
+    while tasks.len() < worker_limit && !stop_admitting {
+        if should_cancel() {
+            cancellation_observed = true;
+            stop_admitting = true;
+            break;
+        }
+        match admit_next_gr_scan_task(
+            &mut tasks,
+            &mut next_channel,
+            &mut in_flight,
+            completed,
+            &found_channels,
+            &scan_channel,
+            &mut on_progress,
+        ) {
+            Ok(true) => {}
+            Ok(false) => break,
+            Err(error) => {
+                progress_error = Some(error);
+                stop_admitting = true;
+            }
+        }
+    }
+
+    while !tasks.is_empty() {
+        if !stop_admitting && should_cancel() {
+            cancellation_observed = true;
+            stop_admitting = true;
+        }
+        tokio::select! {
+            next = tasks.next() => {
+                let Some((channel, result)) = next else { break; };
+                in_flight.remove(&channel);
+                completed += 1;
+                match result {
+                    Ok(true) => { found_channels.insert(channel); }
+                    Ok(false) => {}
+                    Err(error) if error.downcast_ref::<NoServiceFound>().is_some() => {}
+                    Err(error) => {
+                        if matches!(
+                            error.downcast_ref::<crate::error::Error>(),
+                            Some(crate::error::Error::TunerUnavailable)
+                        ) {
+                            tracing::warn!(channel, "GR scan could not acquire a tuner lease");
+                        } else {
+                            tracing::warn!(channel, "GR channel scan failed");
+                        }
+                        failed_channels += 1;
+                    }
+                }
+                if progress_error.is_none() {
+                    if let Err(error) = publish_gr_scan_progress(
+                        &mut on_progress,
+                        completed,
+                        &in_flight,
+                        &found_channels,
+                    ) {
+                        progress_error = Some(error);
+                        stop_admitting = true;
+                    }
+                }
+                while tasks.len() < worker_limit && !stop_admitting {
+                    if should_cancel() {
+                        cancellation_observed = true;
+                        stop_admitting = true;
+                        break;
+                    }
+                    match admit_next_gr_scan_task(
+                        &mut tasks,
+                        &mut next_channel,
+                        &mut in_flight,
+                        completed,
+                        &found_channels,
+                        &scan_channel,
+                        &mut on_progress,
+                    ) {
+                        Ok(true) => {}
+                        Ok(false) => break,
+                        Err(error) => {
+                            progress_error = Some(error);
+                            stop_admitting = true;
+                        }
+                    }
+                }
+            }
+            _ = tokio::time::sleep(GR_SCAN_CANCEL_POLL_INTERVAL), if !stop_admitting => {
+                if should_cancel() {
+                    cancellation_observed = true;
+                    stop_admitting = true;
+                }
+            }
+        }
+    }
+
+    let found_channels = found_channels.into_iter().collect::<Vec<_>>();
+    let result = GrScanResult {
+        found_channels,
+        failed_channels,
+        completed,
+        current_channel: None,
+        interrupted: cancellation_observed,
+    };
+    if let Some(error) = progress_error {
+        return Err(error);
+    }
+    Ok(result)
+}

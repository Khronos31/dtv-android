diff --git src/libtsduck/base/tsSysUtilsTemplate.h src/libtsduck/base/tsSysUtilsTemplate.h
index e31f785f..11abb18d 100644
--- vendor/tsduck-arib/src/libtsduck/base/tsSysUtilsTemplate.h
+++ vendor/tsduck-arib/src/libtsduck/base/tsSysUtilsTemplate.h
@@ -32 +32 @@
-#if defined(TS_UNIX)
+#if defined(TS_UNIX) && !defined(__ANDROID__)
@@ -35,0 +36,75 @@
+#if defined(__ANDROID__)
+#include <dirent.h>
+#include <fnmatch.h>
+#include <unistd.h>
+#include <algorithm>
+#include <string>
+#include <vector>
+
+namespace ts_android_glob {
+    inline bool has_meta(const std::string& component)
+    {
+        return component.find_first_of("*?[") != std::string::npos;
+    }
+
+    inline std::string join(const std::string& base, const std::string& name)
+    {
+        return base.empty() ? name : (base == "/" ? "/" + name : base + "/" + name);
+    }
+
+    inline void expand(const std::string& base, const std::string& rest, std::vector<std::string>& result)
+    {
+        if (rest.empty()) {
+            result.push_back(base.empty() ? "." : base);
+            return;
+        }
+        const std::string::size_type slash = rest.find('/');
+        const std::string component = rest.substr(0, slash);
+        const std::string tail = slash == std::string::npos ? std::string() : rest.substr(slash + 1);
+        if (!has_meta(component)) {
+            const std::string next = join(base, component);
+            if (tail.empty()) {
+                if (::access(next.c_str(), F_OK) == 0) {
+                    result.push_back(next);
+                }
+            }
+            else {
+                expand(next, tail, result);
+            }
+            return;
+        }
+        DIR* directory = ::opendir(base.empty() ? "." : base.c_str());
+        if (directory == nullptr) {
+            return;
+        }
+        for (struct dirent* entry = ::readdir(directory); entry != nullptr; entry = ::readdir(directory)) {
+            const std::string name(entry->d_name);
+            if ((name == "." || name == "..") || ::fnmatch(component.c_str(), name.c_str(), FNM_PERIOD) != 0) {
+                continue;
+            }
+            const std::string next = join(base, name);
+            if (tail.empty()) {
+                result.push_back(next);
+            }
+            else {
+                expand(next, tail, result);
+            }
+        }
+        ::closedir(directory);
+    }
+
+    inline std::vector<std::string> expand(const std::string& pattern)
+    {
+        std::vector<std::string> result;
+        if (!pattern.empty() && pattern[0] == '/') {
+            expand("/", pattern.substr(1), result);
+        }
+        else {
+            expand(std::string(), pattern, result);
+        }
+        std::sort(result.begin(), result.end());
+        return result;
+    }
+}
+#endif
+
@@ -80,0 +156,7 @@ bool ts::ExpandWildcardAndAppend(CONTAINER& container, const UString& pattern)
+#if defined(__ANDROID__)
+    const std::vector<std::string> files = ts_android_glob::expand(pattern.toUTF8());
+    for (const std::string& file : files) {
+        container.push_back(UString::FromUTF8(file));
+    }
+    return true;
+#else
@@ -94,0 +177 @@ bool ts::ExpandWildcardAndAppend(CONTAINER& container, const UString& pattern)
+#endif

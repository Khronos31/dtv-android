+#if defined(__ANDROID__)
+    const std::vector<std::string> files = ts_android_glob::expand(pattern.toUTF8());
+    for (const std::string& file : files) {
+        container.push_back(UString::FromUTF8(file));
+    }
+    return true;
+#else
     ::glob_t gl;
     ::memset(&gl, 0, sizeof (gl));
     int status = ::glob(pattern.toUTF8().c_str(), 0, nullptr, &gl);
     if (status == 0) {
         for (size_t n = 0; n < gl.gl_pathc; n++) {
             const UString file(UString::FromUTF8(gl.gl_pathv[n]));
             // Filter out . and ..
             if (file != u"." && file != u"..") {
                 container.push_back(file);
             }
         }
     }
     ::globfree (&gl);
     return status == 0 || status == GLOB_NOMATCH;
+#endif
